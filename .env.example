# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).

# Públicas: podem ir para o navegador (o acesso é protegido pelo RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA: só no servidor. Necessária para criar usuários e redefinir senhas.
# Nunca compartilhe nem coloque em variáveis NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nome exibido na tela de login
NEXT_PUBLIC_RESTAURANT_NAME=Restaurante do Cacau
